DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=portfolio

# Full connection string for Prisma
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

# ── Web app ──────────────────────────────────────────────
# Public API URL (with /v1 prefix) — web app uses this to call the API
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
# Origin URL (no /v1) — used for metadataBase, OG tags, JSON-LD
NEXT_PUBLIC_API_URL_ORIGIN=http://localhost:3000
# Calendly embed URL (optional — leave empty to hide the CTA)
NEXT_PUBLIC_CALENDLY_URL=
# Google Analytics measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID (optional)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# GlitchTip / Sentry DSN — client-side
NEXT_PUBLIC_GLITCHTIP_DSN=

# ── API server ───────────────────────────────────────────
PORT=3001
# Base URL of the web app (used for magic-link emails, OAuth redirects)
APP_URL=http://localhost:3000
# CORS origin — set to your production domain in prod
CORS_ORIGIN=http://localhost:3000

# ── Auth / JWT ───────────────────────────────────────────
JWT_SECRET=changeme-generate-a-random-string

# ── OAuth — GitHub ───────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/v1/auth/github/callback

# ── OAuth — LinkedIn ─────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3001/v1/auth/linkedin/callback

# ── LLM / AI chat ───────────────────────────────────────
# OpenAI-compatible API base URL
LLAMA_BASE_URL=http://localhost:8080/v1
LLAMA_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Email (Nodemailer / SMTP) ───────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_IGNORE_TLS=true
SMTP_FROM=noreply@nahyan.dev

# ── Media / image storage ────────────────────────────────
# STORAGE_DRIVER selects the storage adapter: "local" (self-hosted disk) today,
# "s3" (Cloudflare R2 / AWS S3) later — no other code changes required.
STORAGE_DRIVER=local
# Where the local-disk adapter writes objects (a Docker volume in production).
MEDIA_ROOT=var/media
# Base URL the stored keys resolve against. In prod this is the site/CDN origin
# that serves /media/*.
MEDIA_BASE_URL=http://localhost:3000

# ── Error tracking (optional) ────────────────────────────
# GlitchTip / Sentry DSN — server-side
GLITCHTIP_DSN=

# ── Seed data ────────────────────────────────────────────
SEED_ADMIN_EMAIL=nahyanm4@gmail.com
SEED_ADMIN_PASSWORD=changeme
